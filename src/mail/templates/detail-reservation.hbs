<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Détail de votre réservation</title>
    <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
    <style type="text/css">
        body { margin: 0; padding: 0; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
        table { border-collapse: collapse; mso-table-lspace: 0; mso-table-rspace: 0; }
        img { border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; }
        a { text-decoration: none; color: #111827; }
    </style>
</head>

<body
    style="margin: 0; padding: 0; background-color: #e5e7eb; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color: #e5e7eb;">
        <tr>
            <td align="center" style="padding: 40px 20px;">
                <!--[if mso]>
                <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" align="center"><tr><td>
                <![endif]-->
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"
                    style="max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.07);">

                    <!-- Logo -->
                    <tr>
                        <td align="center" style="padding: 24px 24px 16px;">
                            <span style="font-size: 14px; font-style: italic; color: #111827;">Restaurant</span>
                            <span style="font-size: 28px; font-weight: 700; color: #111827; letter-spacing: -0.5px;"> OS</span>
                        </td>
                    </tr>

                    <!-- Icon -->
                    <tr>
                        <td align="center" style="padding: 16px 24px 8px;">
                            <table role="presentation" align="center" cellspacing="0" cellpadding="0" border="0">
                                <tr>
                                    <td align="center"
                                        style="width: 80px; height: 80px; background-color: #f3f4f6; border-radius: 50%; border: 2px solid #e5e7eb;">
                                        <span style="font-size: 36px; line-height: 1;">📅</span>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding: 0 48px;">
                            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                                <tr><td style="height: 1px; background-color: #e5e7eb; font-size: 1px; line-height: 1px;">&nbsp;</td></tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Titre -->
                    <tr>
                        <td align="center" style="padding: 24px 48px 8px;">
                            <h1 style="margin: 0; font-size: 22px; font-weight: 700; color: #111827;">Détail de votre réservation</h1>
                        </td>
                    </tr>

                    <!-- Client -->
                    <tr>
                        <td style="padding: 8px 48px 12px;">
                            <p style="margin: 0 0 6px; font-size: 14px; color: #111827;"><strong>Client</strong></p>
                            <p style="margin: 0 0 2px; font-size: 14px; color: #6b7280;">{{clientName}}</p>
                            <p style="margin: 0 0 2px; font-size: 14px; color: #6b7280;">{{clientEmail}}</p>
                            {{#if clientTelephone}}
                            <p style="margin: 0 0 2px; font-size: 14px; color: #6b7280;">{{clientTelephone}}</p>
                            {{/if}}
                            {{#if clientAdresse}}
                            <p style="margin: 0; font-size: 14px; color: #6b7280;">{{clientAdresse}}</p>
                            {{/if}}
                        </td>
                    </tr>

                    <!-- Date, créneau, type, statut, code -->
                    <tr>
                        <td style="padding: 8px 48px 16px;">
                            <p style="margin: 0 0 4px; font-size: 14px; color: #6b7280;"><strong>Date :</strong> {{dateReservation}}</p>
                            <p style="margin: 0 0 4px; font-size: 14px; color: #6b7280;"><strong>Créneau :</strong> {{heureDebut}} – {{heureFin}}</p>
                            <p style="margin: 0 0 4px; font-size: 14px; color: #6b7280;"><strong>Type :</strong> {{typeReservationLabel}}</p>
                            <p style="margin: 0 0 4px; font-size: 14px; color: #6b7280;"><strong>Statut :</strong> {{statusLabel}}</p>
                            {{#if code}}
                            <p style="margin: 0; font-size: 14px; color: #6b7280;"><strong>Code réservation :</strong> {{code}}</p>
                            {{/if}}
                        </td>
                    </tr>

                    <!-- Tables -->
                    <tr>
                        <td style="padding: 8px 48px 16px;">
                            <p style="margin: 0 0 6px; font-size: 14px; color: #111827;"><strong>Tables réservées</strong></p>
                            <p style="margin: 0; font-size: 14px; color: #6b7280;">{{tablesList}}</p>
                        </td>
                    </tr>

                    <!-- Menus (si réservation avec menus) -->
                    {{#if hasMenus}}
                    <tr>
                        <td style="padding: 8px 48px 16px;">
                            <p style="margin: 0 0 8px; font-size: 14px; color: #111827;"><strong>Menus prévus</strong></p>
                            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"
                                style="font-size: 14px; border: 1px solid #e5e7eb; border-radius: 6px;">
                                <tr style="background-color: #f9fafb;">
                                    <td style="padding: 10px 12px; border-bottom: 1px solid #e5e7eb; color: #111827;"><strong>Menu</strong></td>
                                    <td style="padding: 10px 12px; border-bottom: 1px solid #e5e7eb; color: #111827; text-align: center;"><strong>Qté</strong></td>
                                    <td style="padding: 10px 12px; border-bottom: 1px solid #e5e7eb; color: #111827; text-align: right;"><strong>Prix unit.</strong></td>
                                    <td style="padding: 10px 12px; border-bottom: 1px solid #e5e7eb; color: #111827; text-align: right;"><strong>Sous-total</strong></td>
                                </tr>
                                {{#each menuItems}}
                                <tr>
                                    <td style="padding: 10px 12px; border-bottom: 1px solid #f3f4f6; color: #374151;">{{nom}}</td>
                                    <td style="padding: 10px 12px; border-bottom: 1px solid #f3f4f6; color: #374151; text-align: center;">{{quantity}}</td>
                                    <td style="padding: 10px 12px; border-bottom: 1px solid #f3f4f6; color: #374151; text-align: right;">{{prixUnitaireStr}}</td>
                                    <td style="padding: 10px 12px; border-bottom: 1px solid #f3f4f6; color: #374151; text-align: right;">{{sousTotalStr}}</td>
                                </tr>
                                {{/each}}
                            </table>
                            <p style="margin: 10px 0 0; font-size: 15px; font-weight: 700; color: #111827;">Total menus : {{totalMenusStr}}</p>
                        </td>
                    </tr>
                    {{/if}}

                    <!-- Paiement (si présent) -->
                    {{#if hasPayment}}
                    <tr>
                        <td style="padding: 8px 48px 16px;">
                            <p style="margin: 0 0 6px; font-size: 14px; color: #111827;"><strong>Paiement</strong></p>
                            <p style="margin: 0 0 2px; font-size: 14px; color: #6b7280;">Type : {{paymentTypeLabel}}</p>
                            <p style="margin: 0 0 2px; font-size: 14px; color: #6b7280;">Montant : {{paymentMontantStr}}</p>
                            {{#if paymentReference}}
                            <p style="margin: 0; font-size: 14px; color: #6b7280;">Référence : {{paymentReference}}</p>
                            {{/if}}
                        </td>
                    </tr>
                    {{/if}}

                    <!-- Message -->
                    <tr>
                        <td align="center" style="padding: 16px 48px 24px;">
                            <p style="margin: 0; font-size: 14px; line-height: 1.5; color: #6b7280;">
                                Merci pour votre réservation. À bientôt chez Restaurant OS.
                            </p>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="padding: 24px 48px; background-color: #f9fafb; border-radius: 0 0 8px 8px;">
                            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                                <tr>
                                    <td align="center" style="padding-bottom: 12px;">
                                        <a href="#" style="margin: 0 8px; font-size: 12px; color: #111827;">Confidentialité</a>
                                        <span style="color: #d1d5db;">|</span>
                                        <a href="#" style="margin: 0 8px; font-size: 12px; color: #111827;">Aide</a>
                                        <span style="color: #d1d5db;">|</span>
                                        <a href="#" style="margin: 0 8px; font-size: 12px; color: #111827;">À propos</a>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" style="font-size: 12px; line-height: 1.5; color: #9ca3af;">
                                        Cet email vous a été envoyé par Restaurant OS. Récapitulatif de votre réservation.
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                </table>
                <!--[if mso]></td></tr></table><![endif]-->
            </td>
        </tr>
    </table>
</body>

</html>
